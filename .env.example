# Repository-root environment file.
# web `npm run dev` loads this path (`dotenv -e ../.env -- next dev`).
# scraper/lib/api.py loads the same file
# (Path(__file__).parent.parent.parent / '.env' from scraper/lib/api.py).
# Copy to `.env` and fill in real values there. Leave this example empty.
# `next build` and `next start` use the process environment (Vercel sets it on deploy).

# --- Web: public (included in the client bundle) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_MAPTILER_KEY=
# Preferred public origin for OAuth callbacks. Example: http://localhost:3000
# Set this on Vercel Production only. A Preview value sends preview sign-in back to production.
NEXT_PUBLIC_SITE_URL=

# --- Web: server only ---
# Service role key. The app and the scraper read SUPABASE_KEY.
SUPABASE_KEY=
# Comma-separated Supabase user UUIDs allowed into admin routes.
ADMIN_USER_IDS=
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM=
# M-Dining JSON API (web capacity route and the scraper).
MDINING_API_KEY=
MDINING_BASE_URL=

# --- Scraper (same file) ---
# Project URL. The scraper reads SUPABASE_URL.
SUPABASE_URL=
# Optional failure-alert webhook. Leave empty to skip.
DISCORD_WEBHOOK_URL=

# --- Optional tooling (root package.json only) ---
# `npm run db:pull-prod`
PROD_DB_URL=
# `npm run gen:types`
SUPABASE_PROJECT_ID=
